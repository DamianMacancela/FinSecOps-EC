// =================================================================================
// REGLA 03: Escalada de Privilegios (Domain Admins / db_owner) o Carga de Servicio/Driver en Servidor Core
// Mapeo MITRE ATT&CK: T1098 (Account Manipulation) / T1543.003 (Windows Service) / T1068 (BYOVD)
// Marco Regulatorio: ISO 27001 A.8.2 / A.8.9 - Pistas de Auditoría Inalterables SEPS
// =================================================================================
let CoreServers = dynamic(["SRV-CORE-DB01", "SRV-AD-DC01", "SRV-BANCA-WEB01"]);
SecurityEvent
| where Computer in~ (CoreServers)
| where EventID in (4728, 4732, 4756, 4697, 7045) // 4728/4732: Add to Privileged Group; 4697/7045: Service/Driver Installed
| extend TargetGroupOrService = case(
    EventID in (4728, 4732, 4756), TargetUserName,
    EventID in (4697, 7045), ServiceName,
    "Unknown"
)
| project TimeGenerated, Computer, Account, SubjectUserName, TargetGroupOrService, EventID, Activity
| extend AlertSeverity = "High",
    MitreTactic = "Privilege Escalation / Persistence",
    RegulatoryNote = "Requiere ticket de control de cambios autorizado (SEPS Riesgo Operativo)"
